{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mochilitas-donaciones",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "MOCHILITAS_KV",
      "id": "REEMPLAZAR_CON_ID_DE_TU_KV"
    }
  ]
}
